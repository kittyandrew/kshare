# Copy to .env (gitignored) and fill in. Loaded by direnv via .envrc.
#
# OIDC: required. The server hard-fails at boot if these are unset; shipping a misconfigured issuer should
# be loud, not deferred.
#
# Issuer URL is the Zitadel public base (no trailing slash). Both the CLI and the server read it: the server
# for JWKS discovery, the CLI for the device authorization endpoint.
KSHARE_OIDC_ISSUER=https://auth.example.com

# Audience = Zitadel project ID for the `kshare` project. The server verifies the access token's `aud` claim
# contains this value; the CLI requests it via the `urn:zitadel:iam:org:project:id:<aud>:aud` scope so
# Zitadel adds it to the token.
KSHARE_OIDC_AUDIENCE=000000000000000000

# CLI-only: client ID of the `kshare-cli` Native application in Zitadel. The server never reads this, being
# a resource server rather than a client.
KSHARE_OIDC_CLIENT_ID=000000000000000000

# CLI-only: the server URL `kshare auth login` defaults to, so a wrapped binary needs no flag. `--server URL`
# still overrides it. Unset means http://localhost:6980. The resolved URL is persisted into
# ~/.config/kshare/auth.json at login and every later command reads it from there, so changing this
# afterwards cannot redirect an upload behind your back.
# KSHARE_SERVER=https://share.example.com

# Logging: structured JSON by default (machine-greppable). Switch to `console` for tinted human output
# during local development. Level via the standard zerolog names (trace|debug|info|warn|error|fatal).
# KSHARE_LOG_FORMAT=console
# KSHARE_LOG_LEVEL=debug

# Server-side knobs. The defaults are fine for production; they are listed here so a grep of .env.example is
# the single source of truth for what the server reads from the environment.
# KSHARE_LISTEN=:6980
# KSHARE_DATA=/data
# KSHARE_MAX_UPLOAD_SIZE=104857600   # 100 MiB, bytes
# KSHARE_DEFAULT_TTL=7d              # 7 days. Accepts d/w (api.ParseTTL)
# KSHARE_MIN_TTL=10m                 # rejects shorter requests; also the sweeper tick interval
# KSHARE_MAX_TTL=365d                # 365 days
