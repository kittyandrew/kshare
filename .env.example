# Copy to .env (gitignored) and fill in. Loaded by direnv via .envrc.
#
# OIDC: required. The server hard-fails at boot if these are unset --
# shipping a misconfigured issuer should be loud, not deferred.
#
# Issuer URL is the Zitadel public base (no trailing slash). Both the
# CLI and the server read this -- server uses it for JWKS discovery,
# CLI uses it for the device authorization endpoint.
KSHARE_OIDC_ISSUER=https://auth.example.com

# Audience = Zitadel project ID for the `kshare` project. The server
# verifies the access token's `aud` claim contains this value; the
# CLI requests it via the `urn:zitadel:iam:org:project:id:<aud>:aud`
# scope so Zitadel adds it to the token.
KSHARE_OIDC_AUDIENCE=000000000000000000

# CLI-only: client ID of the `kshare-cli` Native application in Zitadel.
# The server doesn't read this -- it's a resource server, not a client.
KSHARE_OIDC_CLIENT_ID=000000000000000000

# Note: server URL is NOT an env var. Pass `--server URL` to
# `kshare login` (defaults to http://localhost:6980); the URL is then
# persisted into ~/.config/kshare/auth.json alongside the tokens.

# Logging: structured JSON by default (machine-greppable). Switch to
# `console` for tinted human output during local development. Level
# via standard zerolog names (trace|debug|info|warn|error|fatal).
# KSHARE_LOG_FORMAT=console
# KSHARE_LOG_LEVEL=debug

# Server-side knobs. Defaults are fine for production; documented here
# so a grep of .env.example is the single source of truth for what
# the server reads from the environment.
# KSHARE_LISTEN=:6980
# KSHARE_DATA=/data
# KSHARE_MAX_UPLOAD_SIZE=104857600   # 100 MiB, bytes
# KSHARE_DEFAULT_TTL=7d              # 7 days. Accepts d/w (api.ParseTTL)
# KSHARE_MIN_TTL=10m                 # rejects shorter requests; sweeper tick interval
# KSHARE_MAX_TTL=365d                # 365 days
